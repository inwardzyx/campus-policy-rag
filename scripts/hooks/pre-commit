#!/usr/bin/env bash
# ============================================================
# pre-commit —— 只跑【零 token】的机械检查
# ============================================================
# ★ 为什么这里不自动派 cc / DSH：
#   每起一个 cc 进程 ≈18K token 冷启动，55 个提交就是 100万+，
#   而绝大多数提交（比如改 README措辞）根本不需要审稿人。
#   ⇒ 派 agent 留给「改既有代码之前」这个真触发点（见 CLAUDE.md 硬规矩 2），
#     钩子里只做一件事：**几毫秒就能查完、且不留假象**的检查。
#
# ⚠️ 勾 --no-verify 能绕过（git原生行为）。这不是漏洞，
#    是"绕过检查"本身就得留下痕迹（用了 --no-verify 就不该写"检查过了"）。
# ============================================================

set -uo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# ★ 解释器用绝对路径：这台机器裸敲 python 会命中 conda base(3.8)，
#   跑起来的结果不能代表项目环境（见用户级记忆里的环境事实）。
# ⚠️ ★ 必须用 [ -f ] 而不是 [ -x ]——
#   Git Bash 的 `-x` 对 Windows 形式的路径（D:/...）判不出可执行，会静默 false
#   ⇒ PY 变成空字符串 ⇒ `"$PY" script.py` 退化成 `"script.py"`
#   ⇒ **检查整段被跳过，而钩子照样 exit 0**。
#   这是实测发生过的：2026-10-11 我把修复提交后，这个文件又被覆盖回旧版一次，
#   差点让"检查通过"变成一句假话。所以这里额外加了两道：
#     ① 验活（`-c "import sys"` 能不能跑）② 都失败就**报错退出**，绝不静默跳过。
PY="D:/Python-project/.venv/Scripts/python.exe"
if [ ! -f "$PY" ]; then
    PY="$(command -v python3 || command -v python || true)"
fi
if [ -z "$PY" ] || ! "$PY" -c "import sys" >/dev/null 2>&1; then
    echo "[pre-commit] ⚠⚠ Python 解释器不可用 —— 本次提交**未做任何检查**。"
    echo "             请装好 D:/Python-project/.venv 或把 PY 改成可用的路径。"
    exit 1
fi

fail=0

# ---- 1. 数字对账：README 的数字 vs 落盘产物 ----
if "$PY" "$REPO/scripts/check_readme_numbers.py"; then
    echo "[pre-commit] 数字对账 OK"
else
    echo "[pre-commit] ★ 数字对账失败 —— 上面列出的数字与产物不一致"
    echo "             要绕过请用 git commit --no-verify，"
    echo "             但 commit 信息里别写「检查通过了」。"
    fail=1
fi

echo
if [ "$fail" -ne 0 ]; then
    echo "[pre-commit] 有检查没通过，提交被拦下。"
    exit 1
fi
echo "[pre-commit] 全部通过"
exit 0