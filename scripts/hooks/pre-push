#!/usr/bin/env bash
# ============================================================
# pre-push —— 推之前挡住「本不该进仓库」的文件
# ============================================================
# ★ 为什么需要它（2026-10-11，一起真实事故）：
#   提交 7252a69（2026-09-24 10:53）把 CLAUDE.md + 4 个 cc_*.md 推上了公开仓库。
#   次日 16:14 主干被 git filter-branch 重写，这些文件不在当前树里了 ——
#   **但 GitHub 上那个提交仍按 SHA 可达**，而且
#     https://github.com/<owner>/<repo>/commit/<sha>.patch
#   一个普通 URL 就能把 5 个文件的完整正文吐出来（实测 200 / 20788 字节）。
#
#   ⇒ 教训一句话：**push 是单向门。**
#     `.gitignore` 只挡"以后"；删除本地分支对远端毫无帮助 ——
#     远端对象的存在性只由「是否 push 过」决定，此后一切本地操作无关。
#
# ★ 它和 pre-commit 的分工：
#   pre-commit → 提交前查 README 的数字对不对（内容正确性）
#   pre-push   → 推之前查有没有不该推的文件（出口安全）
#   两者都只做「几毫秒能查完、且不留假象」的检查，都不派 agent。
#
# ⚠️ 已知边界：它拦不住"已经在远端的孤儿提交"（那要靠推后审计，
#    见 scripts/hooks/README.md 的 P2 一节）。
# ============================================================

set -uo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# 解释器用绝对路径（裸敲 python 会命中 conda base，见用户级环境事实）
#⚠️ ★ 这里必须用 [ -f ] 而不是 [ -x ]——
#   Git Bash 的 `-x` 对 Windows 形式的路径（D:/...）判不出可执行，
#   会静默 false，于是 PY 变成空字符串，后面 `"$PY" script.py` 变成
#   `"script.py"`，钩子的检查**整段被跳过**（实测：hook 直接卡死在这里）。
#   这是原版钩子里就有的 bug，2026-10-11 实测发现。
PY="D:/Python-project/.venv/Scripts/python.exe"
if [ ! -f "$PY" ]; then
    PY="$(command -v python3 || command -v python || true)"
fi
if [ -z "$PY" ]; then
    echo "[pre-push] ⚠⚠ 找不到 Python 解释器 —— 本次推送**未做任何检查**。"
    echo "           请装好 D:/Python-project/.venv 或把 PY 改成可用的路径。"
    exit 1
fi
# ★ 顺带验一下解释器真的能跑（防止 PY 指向一个坏掉的 venv）
if ! "$PY" -c "import sys" >/dev/null 2>&1; then
    echo "[pre-push] ⚠⚠ Python 解释器不可用（$PY）—— 本次推送未做任何检查。"
    exit 1
fi

fail=0

# ---- 1. 出口安全：有没有不该推上去的文件 ----
# ⚠️ ★ git 调用 pre-push 钩子的协议（githooks(5)）：
#     **位置参数 = <remote> <url>，ref 行走 stdin**（每行 4 段：local ref/sha、remote ref/sha）。
#   check_push_paths.py 不带参数时正是从 stdin 读这段，所以这里**原样把 stdin 透下去**，
#   一个字都不用转换。
#   ⚠️ 别改成`"$@" --paths "$@"`那类转法—— 2026-10-11 我试过一次，是错的：
#     真实 push 时 ref 根本不在"$@"里，转过去等于传了个空集合，检查形同虚设。
#   自测方式（手工喂stdin，模拟真实协议）：
#     printf 'refs/heads/main <sha> refs/heads/main <sha>\n' | bash .git/hooks/pre-push origin url
if "$PY" "$REPO/scripts/check_push_paths.py"; then
    echo "[pre-push] 出口安全 OK"
else
    echo "[pre-push] ★ 有不该推的文件被拦下（上面列出的那些）"
    fail=1
fi
echo

# ---- 2. 产物合理性：有没有"坏环境跑出来的结果"混进去 ----
# ★ 起因：2026-10-11 一次坏环境下跑的评测，把 report-vector.md 覆盖成
#   Recall@5 0/15、两个不同题集的极值撞成同一个常数 0.4240，
#   而 run_eval.py 自己不报错（它忠实报告了它算出来的东西）。
#   ⇒ 这个检查与 git 无关（产物可能在任何一次运行后变坏），但必须在推之前拦。
if "$PY" "$REPO/scripts/check_artifact_sanity.py"; then
    echo "[pre-push] 产物合理性 OK"
else
    echo "[pre-push] ★ 产物不合理（上面列出的那些）—— 查环境后重跑，别当基线用"
    fail=1
fi
echo

# ---- 3. 判据纪律：CLAUDE.md 写的规矩，判据脚本里有没有对应实现 ----
# ★ 起因：规矩文档也会漂 —— 那一节是照着两次真实踩坑写的，
#   但半年后没人再看代码，"当时已经修好了"这句话会碎，而没人知道它碎了。
#   ⇒ 规矩必须有一条"只读代码就能判"的锚点。
# ★★ 为什么这道检查**不按数据有无来跳过**：
#   它只读代码（scripts/*.py + CLAUDE.md），**不碰任何产物**。
#   ⇒ 没有"在别人机器上变成空壳"的可能，必须无条件跑。
#   （反过来看：今天刚踩过的坑就是这个 —— 一个扫不到东西的检查器照样报绿。）
#   ⚠️ CLAUDE.md 按 .gitignore **不进仓库**。所以这道检查在别人 clone 下来时
#   会报「找不到规矩那一节」⇒ 那是**正确地报红**，不是误报；
#   真要单独用这份纪律，先把 CLAUDE.md 的〈假绿的三种形态〉一节抄进你自己的笔记。
if (cd "$REPO" && "$PY" scripts/check_judge_rules.py); then
    echo "[pre-push] 判据纪律 OK"
else
    echo "[pre-push] ★ 判据纪律：CLAUDE.md 写的规矩，代码里还没遵守（上面列出的那些）"
    fail=1
fi
echo

# ---- 4. 仓库内路径引用：文档/脚本里写下的路径，文件真的在不在 ----
# ★ 起因（2026-10-13，一次扫出 5 处真错）：README 指一份不存在的报告、
#   两个文件把 `mcp/` 的探针写成 `agent/`、注释指一个不存在的 tests 文件、
#   夹具说明指 `tests/fixtures/dirty_inbox/README.md`。　refcheck-ignore
#   这类错的后果是"读的人照着去找、找不到、然后什么都不会发生" ——
#   数字对不上会有人怀疑，路径指错了只会让人以为自己记错了。
# ★ 它靠什么区分"别人 clone 上本来就没有"（运行时产物/私人草稿）与"路径指错了"：
#   问 git 的 .gitignore，**不维护白名单**（白名单会漂，.gitignore 是唯一事实来源）。
#   ⚠️ 所以它需要 git 可用；判不出忽略集时它**报红**，不假装通过。
if (cd "$REPO" && "$PY" scripts/check_file_refs.py); then
    echo "[pre-push] 路径引用 OK"
else
    echo "[pre-push] ★ 文档/脚本里有指错的仓库内路径（上面列出的那些）"
    fail=1
fi
echo

# ---- 5. token 报告 ↔ 实测数据 逐格对账 ----
# ★ 起因：2026-10-12 写report-token-cost.md 时，我手工核对了 27 项，
#   却在正文里自己抓到 3 处算错（缓存命中率 67.1%→66.5%、差值 46→47、
#   "52 次调用"→53）。"写完自己读一遍"这种核对读的是自己刚写的句子，
#   不是数据 ⇒ 必须有自动判据。
#
# ⚠️ 边界（必须说清，否则会变成"拦人的噪音"）：
#   这个检查要读 agent/_token_cost.json，而它按 .gitignore **不进仓库**。
#   ⇒ 别人 clone 下来没有这份数据。
#   这里的处理是：**缺数据就说缺、且给出怎么补，不当成"检查通过"**。
#   不能反过来"没数据就当过了" —— 那样这道防线在别人机器上是假的。
DATA="$REPO/agent/_token_cost.json"
if [ -f "$DATA" ]; then
    if (cd "$REPO" && "$PY" scripts/check_token_report.py); then
        echo "[pre-push] token 报告对账 OK"
    else
        echo "[pre-push] ★ token 报告里的数字与实测数据对不上（上面列出的那些）"
        fail=1
    fi
else
    echo "[pre-push] ⚠ 跳过 token 报告对账：缺 agent/_token_cost.json"
    echo "           那份数据按 .gitignore 不进仓库。要查就先跑："
    echo "             python -u agent/token_cost.py --n 20"
fi

# ---- 6. README 声明的"CI 跑哪些测试文件" ↔ pytest 真实收集结果 ----
# ★ 起因（2026-10-14）：README 那句「前两个 job 加起来覆盖全部 57 条（22 + 35）」
#   是好几轮之前的值，实测已收集 **145** 条，而且和同一份 README 里
#   「60 passed」那句自相矛盾。**过期条数比没有条数更坏：它长得像实测。**
#   ⇒ 现在 README 只声明**每个 job 跑哪些文件**（不会腐烂），条数由本检查现算；
#     它还管住那条真正要紧的承诺：**前两个 job 的并集覆盖全部测试文件**
#     （"不存在只在本地跑过的测试"）。
#
# ⚠️ 为什么放在 pre-push 而不是 pre-commit：
#   它要真跑一次 `pytest --collect-only`（实测约 **5 秒**），而 pre-commit 的定位是
#   "几毫秒能查完"（见那个文件头的说明）。5 秒会让每次提交都卡一下 ——
#   而这条判据只在**测试文件集合或 CI 划分变了**的时候才有意义。
#   ⇒ 推到远端之前查一次，是它该待的地方。不需要 Redis / 模型 / key。
if (cd "$REPO" && "$PY" scripts/check_test_counts.py); then
    echo "[pre-push] 测试条数/文件声明 OK"
else
    echo "[pre-push] ★ README 声明的测试文件与真实收集结果不一致（上面列出的那些）"
    fail=1
fi
echo

echo
if [ "$fail" -ne 0 ]; then
    echo "[pre-push] 有检查没通过，推送被拦下。"
    exit 1
fi
echo "[pre-push] 全部通过"
exit 0
